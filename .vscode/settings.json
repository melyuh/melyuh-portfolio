{
  // 保存時の自動整形を有効化
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "always",
    "source.organizeImports": "always"
  },

  // cSpellの単語リスト（VSCodeの「辞書に追加」コマンドでここに追記される）
  "cSpell.words": [
    "mkdocs",
    "melyuh",
    "astral",
    "pnpm",
    "venv",
    "ruff",
    "devcontainer",
    "terraform",
    "Noto",
    "JetBrains",
    "mmdc",
    "svgs",
    "pngs",
    "hrefs",
    "javascripts",
    "pdfs",
    "srcs",
    "weasyprint",
    "glightbox",
    "mermaid",
    "pymdownx",
    "superfences",
    "tabbed",
    "tasklist",
    "magiclink",
    "smartsymbols",
    "linenums",
    "inlinehilite"
  ],
  "errorLens.excludeBySource": ["cSpell"],
  "errorLens.excludePatterns": ["**/mkdocs.yml"],

  // 編集不要なファイル・フォルダをエクスプローラーから非表示
  "files.exclude": {
    "node_modules/": true,
    ".pnpm-store/": true,
    "site/": true,
    ".venv/": true,
    "**/__pycache__/": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    ".ruff_cache/": true,
    ".mypy_cache/": true,
    ".pytest_cache/": true,
    ".cache/": true
  },

  // 関連ファイルを親ファイルの下に折りたたむ
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "pyproject.toml": "uv.lock",
    "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, .prettierrc.json, .markdownlint.json"
  }
}
