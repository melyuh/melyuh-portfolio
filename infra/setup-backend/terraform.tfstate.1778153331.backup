            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"DenyNonTLS\",\n      \"Effect\": \"Deny\",\n      \"Action\": \"s3:*\",\n      \"Resource\": [\n        \"arn:aws:s3:::melyuh-portfolio/*\",\n        \"arn:aws:s3:::melyuh-portfolio\"\n      ],\n      \"Principal\": \"*\",\n      \"Condition\": {\n        \"Bool\": {\n          \"aws:SecureTransport\": \"false\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"AllowSameAccount\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:ListBucket\",\n        \"s3:GetObject\",\n        \"s3:DeleteObject\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::melyuh-portfolio/*\",\n        \"arn:aws:s3:::melyuh-portfolio\"\n      ],\n      \"Principal\": {\n        \"AWS\": \"arn:aws:iam::170157273566:root\"\n      }\n    }\n  ]\n}",
