{
  "name": "melyuh-portfolio",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "pnpmVersion": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot-chat",
        "github.vscode-github-actions",
        "mhutchie.git-graph",
        "vscode-icons-team.vscode-icons",
        "oderwat.indent-rainbow",
        "christian-kohler.path-intellisense",
        "shardulm94.trailing-spaces",
        "streetsidesoftware.code-spell-checker",
        "usernamehw.errorlens",
        "ms-azuretools.vscode-docker",
        "hashicorp.terraform",
        "tamasfe.even-better-toml",
        "hediet.vscode-drawio",
        "redhat.vscode-yaml",
        "charliermarsh.ruff",
        "ms-python.python",
        "esbenp.prettier-vscode",
        "davidanson.vscode-markdownlint",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvInCurrentTerminal": false,
        // Pylanceの重い静的解析を無効化（MkDocs等の実行には影響しない）
        "python.languageServer": "None",
        "python.analysis.enabled": false,

        // 言語ごとのフォーマッター指定
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        // Markdown: 保存時の自動整形は無効（grid cards等の4スペースインデントが崩れるため）
        // 手動フォーマットは Shift+Alt+F、一括整形は poe format-markdown で可能
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": false,
          "editor.wordWrap": "on",
          "editor.quickSuggestions": {
            "comments": "sep",
            "strings": "sep",
            "other": "on"
          }
        },
        // markdownlint の設定は .markdownlint.json で一元管理
        "markdownlint.config": {},
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[html]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[css]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "remote.autoForwardPortsFallback": 0
      }
    }
  },
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.aws ${localEnv:HOME}/.claude ${localEnv:HOME}/.config/gh",
  "postCreateCommand": {
    "fix-permissions": "sudo chown -R vscode /usr/local/share/nvm && sudo chown -R vscode /home/vscode/.config/gh",
    "install-claude-code": "npm install -g @anthropic-ai/claude-code",
    "setup": "bash .devcontainer/setup.sh"
  },
  "postStartCommand": {
    "update-claude-code": "npm install -g @anthropic-ai/claude-code@latest > /dev/null 2>&1 &",
    "update-pnpm": "npm install -g pnpm@latest > /dev/null 2>&1 &",
    "update-uv": "curl -LsSf https://astral.sh/uv/install.sh | sudo env UV_INSTALL_DIR=/bin sh > /dev/null 2>&1 &"
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached"
  ]
}
